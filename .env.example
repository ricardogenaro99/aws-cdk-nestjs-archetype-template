# =========================================================================
# CONFIGURACIÓN LOCAL DE AWS (CDK y Servidor Local)
# =========================================================================
# Este archivo sirve como plantilla. Copia este archivo a uno nuevo llamado
# '.env' en la raíz y configura tus credenciales para desarrollo local.
# El archivo '.env' está en el .gitignore y nunca debe subirse al repositorio.
# =========================================================================

# Credenciales de Acceso AWS (utilizadas para despliegue y SDK local)
AWS_ACCESS_KEY_ID=tu_access_key_id
AWS_SECRET_ACCESS_KEY=tu_secret_access_key
# AWS_SESSION_TOKEN=tu_session_token_opcional (requerido si usas credenciales temporales / SSO)

# Configuración de Región
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# Opcional: Si prefieres utilizar un perfil configurado en ~/.aws/config o credentials
# AWS_PROFILE=tu_perfil_aws

# Variables de Entorno del Negocio para Desarrollo Local
TASKS_TABLE_NAME=nombre_de_la_tabla_dynamodb_desplegada
