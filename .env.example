# =========================================================================
# CONFIGURACIÓN LOCAL (CDK y Servidor Local)
# =========================================================================
# Copia este archivo a '.env' en la raíz y completa los valores.
# '.env' está en .gitignore y nunca debe subirse al repositorio.
# Lo leen: run-cdk.ts (infra:*), infrastructure/bin/infrastructure.ts y server-local.
# =========================================================================

# Credenciales AWS (despliegue y SDK local)
AWS_ACCESS_KEY_ID=tu_access_key_id
AWS_SECRET_ACCESS_KEY=tu_secret_access_key
# AWS_SESSION_TOKEN=tu_session_token_opcional (requerido si usas credenciales temporales / SSO)

# Alternativa a las claves: perfil de ~/.aws/config o ~/.aws/credentials
# AWS_PROFILE=tu_perfil_aws

# Región y Cuenta AWS
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
# AWS_ACCOUNT_ID=036873953739

# Ambiente de despliegue CDK: DESA | TEST | PROD (default DESA)
# Define naming, retención de logs y RemovalPolicy (ver infrastructure/README.md)
STAGE=DESA

# =========================================================================
# BASE DE DATOS POSTGRESQL & PRISMA ORM (SEPARACIÓN DE CONEXIONES)
# =========================================================================
# DATABASE_URL: Endpoint transaccional con connection pooler (PgBouncer en puerto 6543 para runtime Lambda)
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# DIRECT_URL: Conexión directa a PostgreSQL sin PgBouncer (puerto 5432) exclusiva para Prisma CLI (db push, migrate)
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# =========================================================================
# SEGURIDAD & AUTENTICACIÓN
# =========================================================================
JWT_SECRET=super_secret_jwt_key_genaryth_2026
JWT_EXPIRES_IN=7d

# =========================================================================
# COST OPTIMIZATION & PERIMETER TOGGLES (FinOps Zero-Cost)
# =========================================================================
ENABLE_WAF=false
ENABLE_CLOUDFRONT=false

# =========================================================================
# SERVIDOR LOCAL & LEGACY DYNAMODB
# =========================================================================
# Nombre de la tabla DynamoDB desplegada (salida de infra:deploy / consola)
TASKS_TABLE_NAME=nombre_de_la_tabla_dynamodb_desplegada
# Segregación de puertos Genaryth (ADR-013): 3000 Frontend, 3001 Backend API, 3002 Studio Hub
PORT=3001
