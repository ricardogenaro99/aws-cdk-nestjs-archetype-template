{
  "name": "@genaryth/archetype-api",
  "version": "1.0.0",
  "private": true,
  "description": "AWS CDK Archetype Template",
  "author": {
    "name": "Ricardo Genaro",
    "url": "https://github.com/ricardogenaro99"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@11.14.0",
  "scripts": {
    "dev": "node --watch -r ts-node/register server-local/server.local.ts",
    "typecheck": "tsc --noEmit && pnpm --filter @genaryth/archetype-infra run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md,yml,yaml}\"",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "build": "tsc && ts-node prepareBuild.ts",
    "postbuild": "cd app && pnpm run package:install",
    "infra:bootstrap": "ts-node run-cdk.ts bootstrap",
    "infra:synth": "pnpm run build && ts-node run-cdk.ts synth",
    "infra:diff": "pnpm run build && ts-node run-cdk.ts diff",
    "infra:deploy": "pnpm run build && ts-node run-cdk.ts deploy",
    "infra:deploy:fast": "pnpm run build && ts-node run-cdk.ts deploy --hotswap",
    "infra:destroy": "ts-node run-cdk.ts destroy",
    "ci:local": "node .genaryth/ci/runner.mjs",
    "ci:local:fast": "node .genaryth/ci/runner.mjs --fast",
    "cd:local": "node .genaryth/cd/runner.mjs",
    "cd:local:full": "node .genaryth/cd/runner.mjs --full",
    "harness:check": "node .genaryth/harness/enforcer.mjs",
    "harness:check:staged": "node .genaryth/harness/enforcer.mjs --staged",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.609.0",
    "@aws-sdk/client-s3": "^3.609.0",
    "@aws-sdk/client-secrets-manager": "^3.609.0",
    "@aws-sdk/client-sfn": "^3.609.0",
    "@aws-sdk/client-ssm": "^3.609.0",
    "@aws-sdk/lib-dynamodb": "^3.609.0",
    "@aws-sdk/s3-request-presigner": "^3.609.0",
    "@middy/core": "4.5.5",
    "@nestjs/common": "11.1.21",
    "@nestjs/core": "11.1.21",
    "@prisma/client": "6.4.1",
    "reflect-metadata": "0.1.14",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^9.5.0",
    "@types/aws-lambda": "^8.10.141",
    "@types/express": "^5.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.10.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.5.0",
    "eslint-config-prettier": "^9.1.0",
    "express": "^5.2.1",
    "fs-extra": "^11.2.0",
    "husky": "^9.1.7",
    "prettier": "^3.3.2",
    "prisma": "6.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.2",
    "typescript-eslint": "^8.0.0"
  }
}
