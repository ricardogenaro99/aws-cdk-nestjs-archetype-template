/app/
/dist/
/out/
/lib/**/*.js
/lib/**/*.d.ts
*.tsbuildinfo

# Log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Environment and configuration variables
.env*
!.env.example
*.npmrc
role.json

# Editor & OS files
.idea/
.vscode/*
