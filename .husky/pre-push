#!/bin/sh
# Hook pre-push inteligente de Genaryth Venture Studio (ADR-007 Rev. 2)
# Verifica si el push se dirige directamente a develop, master o main.
# Si hay 2 o más commits salientes, solicita confirmación interactiva para:
# 1) Unificar (squash) en un solo commit semántico limpio.
# 2) Pushear por separado manteniendo el historial granular.
# 3) Cancelar el push (Abortar).

remote="$1"
url="$2"

# Leer la información enviada por git a stdin (<local_ref> <local_oid> <remote_ref> <remote_oid>)
has_commits=0
while read -r local_ref local_oid remote_ref remote_oid; do
  # Ignorar borrado de ramas remotas
  if [ "$local_oid" = "0000000000000000000000000000000000000000" ]; then
    continue
  fi

  # Obtener el nombre simple de la rama de destino
  target_branch="${remote_ref#refs/heads/}"

  # Validar únicamente si la rama de destino es develop, master o main
  if [ "$target_branch" = "develop" ] || [ "$target_branch" = "master" ] || [ "$target_branch" = "main" ]; then
    # Calcular el rango de commits a subir
    if [ "$remote_oid" = "0000000000000000000000000000000000000000" ]; then
      # Rama nueva en remoto: comparar contra origin/master o origin/develop
      if git rev-parse --verify "origin/$target_branch" >/dev/null 2>&1; then
        range="origin/$target_branch..$local_oid"
      else
        range="$local_oid"
      fi
    else
      range="$remote_oid..$local_oid"
    fi

    # Contar commits pendientes
    commit_count=$(git rev-list --count "$range" 2>/dev/null || echo 0)

    if [ "$commit_count" -gt 1 ]; then
      has_commits=1
      echo ""
      echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
      echo " 🛡️  [PRE-PUSH GUARD - GENARYTH VENTURE STUDIO]"
      echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
      echo " ⚠️  Detectados $commit_count commits salientes hacia la rama '$target_branch':"
      echo ""
      git log --oneline "$range" | sed 's/^/   • /'
      echo ""
      echo " Elige cómo deseas proceder:"
      echo "   [1] Unificar (Squash) todo en un solo commit antes de subir"
      echo "   [2] Pushear por separado manteniendo los commits granulares"
      echo "   [3] Cancelar el push (Abortar)"
      echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

      # Comprobar si hay una terminal interactiva conectada
      if [ -t 0 ]; then
        printf " Selecciona una opción [1/2/3]: "
        read -r choice
      elif [ -e /dev/tty ] && [ -r /dev/tty ] && [ -w /dev/tty ] && [ -t 1 ]; then
        printf " Selecciona una opción [1/2/3]: " > /dev/tty
        read -r choice < /dev/tty
      else
        # Si corre en entorno sin TTY interactivo (ej. CI o subshell), permitir por defecto
        choice="2"
      fi

      case "$choice" in
        1)
          echo ""
          echo " 🔄 Procediendo a unificar los $commit_count commits..."
          
          # Verificar si el árbol de trabajo está limpio antes de hacer squash
          if ! git diff-index --quiet HEAD --; then
            echo " ❌ Tienes cambios sin comitear en tu working tree."
            echo "    Por favor haz commit o stash antes de unificar."
            exit 1
          fi

          # Tomar el mensaje del último commit como referencia
          default_msg=$(git log -1 --pretty=%B)

          printf " Ingresa el mensaje para el commit unificado (Enter para mantener el último):\n > " > /dev/tty
          read -r user_msg < /dev/tty
          if [ -z "$user_msg" ]; then
            user_msg="$default_msg"
          fi

          # Realizar reset soft al punto remoto base y generar commit único
          base_commit=$(git merge-base "$local_oid" "$remote_oid" 2>/dev/null || echo "origin/$target_branch")
          git reset --soft "$base_commit"
          git commit -m "$user_msg"

          echo ""
          echo " ✅ Commits unificados exitosamente en 1 solo commit:"
          git log -1 --oneline
          echo ""
          echo " 🚀 Vuelve a ejecutar: git push $remote $target_branch"
          echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
          # Abortamos el push actual para que el usuario empuje el nuevo commit unificado limpio
          exit 1
          ;;
        2)
          echo ""
          echo " ⏩ Aprobado: Pusheando $commit_count commits granulares hacia '$target_branch'..."
          echo ""
          ;;
        *)
          echo ""
          echo " 🛑 Push cancelado por el usuario."
          echo ""
          exit 1
          ;;
      esac
    fi
  fi
done

exit 0
